{
  "expo": {
    "name": "revl",
    "slug": "revl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "revl",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.revl.mobile",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "app.revl.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a039f5e-2dc0-4dd0-b6d3-69c44e8fecb9"
      },
      "supabase": {
        "url": "",
        "publishableKey": ""
      },
      "google": {
        "iosClientId": "",
        "androidClientId": "",
        "webClientId": ""
      }
    },
    "owner": "xlr8_bl",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0a039f5e-2dc0-4dd0-b6d3-69c44e8fecb9",
      "fallbackToCacheTimeout": 0
    }
  }
}
